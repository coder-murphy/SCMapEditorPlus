    CONTROL "Copyright (C) 2003 - 2007\nHenrik Arlinghaus (Suicidal Insanity)", -1, "Static", 0x50020000, 49, 20, 119, 16
    CONTROL "关闭", 1, "Button", 0x50030001, 92, 157, 30, 12
    CONTROL "Coding: Suicidal Insanity\nAdditional Coding: DarkWizzard. \nSpecial Thanks to: \nMerlin, Veldhar Windrider (Gold Dragon), Quantam", -1, "Static", 0x50020000, 6, 42, 210, 42
    CONTROL "Homepage: www.Stormcoast-Fortress.net                          www.nauni.cn", -1, "Static", 0x50020000, 6, 75, 210, 15
    CONTROL "Beta testers: Ojan, Clokr, Darkness22k, General Mengsk, xxxFanta, Bolthead", -1, "Static", 0x50020000, 6, 96, 210, 24
    CONTROL "Additional beta testers: Chuiu_os, Coko, Deathknight, Evolipel, LegacyWeapon, Mini Moose 2707, Yoshi, Beer_KeG, Kenoli, xMog", -1, "Static", 0x50020000, 6, 120, 210, 30
END

