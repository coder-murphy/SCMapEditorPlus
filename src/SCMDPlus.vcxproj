  <!-- 地形集随构建复制到输出目录，exe 可脱离源码树与游戏目录独立运行 -->
  <Target Name="CopyTilesets" AfterTargets="Build">
    <ItemGroup>
      <TilesetFiles Include="$(ProjectDir)..\ts\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(TilesetFiles)" DestinationFolder="$(OutDir)ts" SkipUnchangedFiles="true" />
  </Target>
  <!-- 每次构建后把完整应用目录增量同步到仓库 exe\，方便手动调试 -->
  <Target Name="SyncToExeFolder" AfterTargets="CopyTilesets">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)..\tools\copy-app.ps1&quot; -Source &quot;$(TargetDir).&quot;"
          ContinueOnError="true" />
  </Target>
